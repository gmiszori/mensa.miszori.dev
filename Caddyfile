# Caddy is the public web server: it gets and renews the HTTPS certificate for DOMAIN by itself
# (from Let's Encrypt), compresses responses and passes every request on to Mensaplan Zürich, which
# is only reachable inside the Docker network. Ports 80 and 443 belong to the shared proxy
# (github.com/gmiszori/webserver-proxy), which passes this domain's TLS through untouched.
#
# DOMAIN comes from the .env file next to docker-compose.yml. Without it, Caddy serves
# https://localhost with its own local certificate, for trying the setup out.
{
	servers {
		# Only the proxy reaches this Caddy. It starts every connection with a PROXY header
		# carrying the peer's address, trusted from the proxy's fixed address alone.
		listener_wrappers {
			proxy_protocol {
				allow 172.31.250.2/32
			}
			tls
		}
		# The domain goes through Cloudflare's proxy, so that peer is a Cloudflare server.
		# From Cloudflare's addresses alone, the visitor's address is taken from
		# CF-Connecting-IP, so the access log shows visitors. A request from anywhere else
		# can't set it. Ranges from https://www.cloudflare.com/ips/ (checked 2026-10-31).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
		# The proxy forwards TCP only, so don't advertise HTTP/3 over UDP.
		protocols h1 h2
	}
}

# Authenticated Origin Pulls. With ORIGIN_PULL=on in .env, the TLS handshake only
# succeeds when the client presents the certificate that Cloudflare sends for this
# zone, issued by our own CA in origin-pull-ca.pem. Other Cloudflare customers share
# Cloudflare's addresses, so the firewall alone can't tell them apart; this can.
# Off by default, for local development without Cloudflare in front. Setup and
# rollback: docs/authenticated-origin-pulls.md in github.com/gmiszori/webserver-proxy.
(origin_pull_on) {
	tls {
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/origin-pull-ca.pem
		}
	}
}
(origin_pull_off) {
}

{$DOMAIN:localhost} {
	encode zstd gzip
	import origin_pull_{$ORIGIN_PULL:off}

	# Tell browsers to use only HTTPS for this domain from now on (for a year). Not for
	# localhost, where it would also break plain-HTTP development servers.
	@public not host localhost
	header @public Strict-Transport-Security "max-age=31536000"

	# One line per request on stdout, so `docker compose logs caddy` shows the traffic.
	# Caddy leaves cookies and authorization headers out of these logs.
	log

	# The security contact (RFC 9116); the policy itself is on miszori.dev.
	handle /.well-known/security.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond <<TXT
			Contact: mailto:gergo@miszori.dev
			Expires: 2027-11-01T00:00:00.000Z
			Preferred-Languages: en, de, hu
			Policy: https://miszori.dev/security/
			Canonical: https://{$DOMAIN}/.well-known/security.txt
			TXT 200
	}

	reverse_proxy mensaplan:8080
}

# The HTTP->HTTPS redirect, spelled out: Caddy's automatic redirect server doesn't get the
# PROXY-protocol listener above and would reject every request.
http:// {
	redir https://{host}{uri} 308
}
