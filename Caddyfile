# Caddy is the public web server: it gets and renews the HTTPS certificate for DOMAIN by itself
# (from Let's Encrypt), compresses responses and passes every request on to Mensaplan Zürich, which
# is only reachable inside the Docker network. Ports 80 and 443 belong to the shared proxy
# (github.com/gmiszori/webserver-proxy), which passes this domain's TLS through untouched.
#
# DOMAIN comes from the .env file next to docker-compose.yml. Without it, Caddy serves
# https://localhost with its own local certificate, for trying the setup out.
{
	servers {
		# Only the proxy reaches this Caddy. It starts every connection with a PROXY header
		# carrying the visitor's address, trusted from the proxy's fixed address alone, so the
		# access log shows visitors, not the proxy.
		listener_wrappers {
			proxy_protocol {
				allow 172.31.250.2/32
			}
			tls
		}
		# The proxy forwards TCP only, so don't advertise HTTP/3 over UDP.
		protocols h1 h2
	}
}

{$DOMAIN:localhost} {
	encode zstd gzip

	# Tell browsers to use only HTTPS for this domain from now on (for a year). Not for
	# localhost, where it would also break plain-HTTP development servers.
	@public not host localhost
	header @public Strict-Transport-Security "max-age=31536000"

	# One line per request on stdout, so `docker compose logs caddy` shows the traffic.
	# Caddy leaves cookies and authorization headers out of these logs.
	log

	reverse_proxy mensaplan:8080
}

# The HTTP->HTTPS redirect, spelled out: Caddy's automatic redirect server doesn't get the
# PROXY-protocol listener above and would reject every request.
http:// {
	redir https://{host}{uri} 308
}
