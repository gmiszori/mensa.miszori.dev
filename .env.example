# Copy to .env. DOMAIN is the domain Mensaplan Zürich runs on, e.g. mensa.example.com. It must
# match MENSA_DOMAIN in the shared proxy (github.com/gmiszori/webserver-proxy).
DOMAIN=

# Authenticated Origin Pulls: "on" accepts only connections that present the client
# certificate Cloudflare sends for this zone. Turn it on only after it is enabled in
# Cloudflare; see docs/authenticated-origin-pulls.md in gmiszori/webserver-proxy.
ORIGIN_PULL=off
